# Скопируйте в .env:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# .env не коммитится. Ключи никогда не попадают в код, Git и логи.

# ---------- порты на хосте ----------
WEB_PORT=8080
API_PORT=8000
DB_PORT=5432

# ---------- PostgreSQL ----------
POSTGRES_USER=tk
POSTGRES_PASSWORD=tk
POSTGRES_DB=tk

# ---------- приложение ----------
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# ---------- авторизация ----------
JWT_SECRET=change-me-please-long-random-string
# true — все запросы идут от имени сид-админа (пока нет экрана входа)
AUTH_DEV_MODE=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
SEED_ORG_NAME=Демо-организация

# ---------- LLM ----------
# mock — без внешних вызовов (по умолчанию), gigachat — реальная модель
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=60
# Freemium GigaChat допускает 1 одновременный запрос (иначе 429); на платном тарифе — 5
LLM_MAX_PARALLEL=1

# ---------- GigaChat: общие параметры ----------
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_VERIFY_SSL=true
# В Docker путь к сертификату НУЦ подставляется автоматически.

# ---------- GigaChat: доступ ----------
# Client ID и Client Secret проекта из личного кабинета developers.sber.ru.
# Authorization key (base64 "id:secret") собирается автоматически.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# ---------- GigaChat: LLM ----------
GIGACHAT_LLM_SCOPE=GIGACHAT_API_PERS
GIGACHAT_LLM_MODEL=GigaChat-2

# ---------- GigaChat: эмбеддинги (если EMBEDDING_PROVIDER=gigachat) ----------
# По умолчанию — те же учётные данные. Для отдельного проекта задайте
# GIGACHAT_EMBED_CLIENT_ID / GIGACHAT_EMBED_CLIENT_SECRET.
GIGACHAT_EMBED_SCOPE=GIGACHAT_API_PERS
GIGACHAT_EMBED_MODEL=Embeddings

# ---------- эмбеддинги ----------
# hashing — офлайн (тесты, без ключей); gigachat; openai_compatible — Cloud.ru Foundation Models
EMBEDDING_PROVIDER=hashing
# Cloud.ru: сервисный аккаунт проекта → API-ключ с доступом к Foundation Models
EMBEDDING_BASE_URL=https://foundation-models.api.cloud.ru/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Инструкция для запросов (Qwen3-Embedding); пусто — без инструкции
EMBEDDING_QUERY_INSTRUCTION=Найди нормы Трудового кодекса РФ, применимые к этому пункту трудового договора
EMBEDDING_BATCH_SIZE=32

# ---------- поиск ----------
RETRIEVAL_CANDIDATES=12
RETRIEVAL_TOP_K=4

# ---------- реранкер: none | gigachat | http ----------
# none     — без реранкера, порядок гибридного поиска (по умолчанию)
# gigachat — listwise-реранкинг через GigaChat тем же ключом
# http     — внешний /rerank. Cloud.ru Foundation Models (нужен баланс на счёте):
#   RERANK_HTTP_URL=https://foundation-models.api.cloud.ru/v1/rerank
#   RERANK_HTTP_FORMAT=cohere, RERANK_HTTP_MODEL=BAAI/bge-reranker-v2-m3,
#   RERANK_HTTP_API_KEY=<тот же API-ключ Cloud.ru>
RERANKER=none
GIGACHAT_RERANK_MODEL=GigaChat-2
RERANK_HTTP_URL=https://foundation-models.api.cloud.ru/v1/rerank
RERANK_HTTP_FORMAT=cohere
RERANK_HTTP_MODEL=BAAI/bge-reranker-v2-m3
RERANK_HTTP_API_KEY=
